generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaksi {
  id          Int      @id @default(autoincrement())
  tipe        String
  jumlah      Float
  keterangan  String
  tanggal     DateTime @default(now())
}

model Session {
  id    String @id
  value String
}